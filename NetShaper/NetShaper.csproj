<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>NetShaper</AssemblyName>
    <RootNamespace>NetShaper</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="WinDivert\WinDivert.dll" Condition="Exists('WinDivert\WinDivert.dll')" Link="WinDivert.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="WinDivert\WinDivert64.sys" Condition="Exists('WinDivert\WinDivert64.sys')" Link="WinDivert64.sys" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
