<Window x:Class="NetShaper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetShaper - Network Fluctuation Tester" Width="900" Height="880" MinWidth="820">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Width" Value="62"/><Setter Property="Margin" Value="4,0,0,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="MinWidth" Value="100"/><Setter Property="Margin" Value="4,0,0,0"/></Style>
    <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,8,0,0"/><Setter Property="Padding" Value="8"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    <Style x:Key="Lbl" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="Cell" TargetType="StackPanel"><Setter Property="Orientation" Value="Horizontal"/><Setter Property="Margin" Value="0,3,16,3"/></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="14">

      <Border x:Name="StatusBorder" CornerRadius="8" Padding="16" Background="#FF6B7280">
        <StackPanel>
          <TextBlock x:Name="ModeText" Text="IDLE" FontSize="52" FontWeight="Bold" Foreground="White"/>
          <TextBlock x:Name="NumsText" Text="Not shaping - network is normal" FontSize="20" Foreground="White" TextWrapping="Wrap"/>
          <TextBlock x:Name="InfoText" Text="" FontSize="14" Foreground="White" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <WrapPanel Margin="0,12,0,0">
        <TextBlock Text="Target:" Style="{StaticResource Lbl}"/>
        <ComboBox x:Name="TargetBox" MinWidth="260" SelectedIndex="0" Margin="4,0,16,0">
          <ComboBoxItem Content="All traffic (PC + phone on hotspot)"/>
        </ComboBox>
        <Button x:Name="StartStopBtn" Content="Start shaping" Click="StartStop_Click" FontWeight="Bold" MinWidth="150"/>
        <Button Content="Open log folder" Click="OpenLogs_Click"/>
      </WrapPanel>

      <GroupBox Header="Baseline (GOOD)">
        <WrapPanel>
          <StackPanel Style="{StaticResource Cell}"><TextBlock Text="Up Kbps" Style="{StaticResource Lbl}"/><TextBox x:Name="BaseUp" Text="5000"/></StackPanel>
          <StackPanel Style="{StaticResource Cell}"><TextBlock Text="Down Kbps" Style="{StaticResource Lbl}"/><TextBox x:Name="BaseDown" Text="5000"/></StackPanel>
          <StackPanel Style="{StaticResource Cell}"><TextBlock Text="Latency ms" Style="{StaticResource Lbl}"/><TextBox x:Name="BaseLat" Text="20"/></StackPanel>
          <StackPanel Style="{StaticResource Cell}"><TextBlock Text="Jitter ms" Style="{StaticResource Lbl}"/><TextBox x:Name="BaseJit" Text="5"/></StackPanel>
          <StackPanel Style="{StaticResource Cell}"><TextBlock Text="Loss %" Style="{StaticResource Lbl}"/><TextBox x:Name="BaseLoss" Text="0"/></StackPanel>
          <TextBlock Text="(0 Kbps = unlimited)" Foreground="Gray" Style="{StaticResource Lbl}"/>
        </WrapPanel>
      </GroupBox>

      <GroupBox Header="Fluctuate (keeps changing while ON)">
        <StackPanel>
          <WrapPanel>
            <StackPanel Style="{StaticResource Cell}"><TextBlock Text="Profile" Style="{StaticResource Lbl}"/><ComboBox x:Name="ProfileBox"/></StackPanel>
            <StackPanel Style="{StaticResource Cell}"><TextBlock Text="Min Kbps" Style="{StaticResource Lbl}"/><TextBox x:Name="FMin"/></StackPanel>
            <StackPanel Style="{StaticResource Cell}"><TextBlock Text="Max Kbps" Style="{StaticResource Lbl}"/><TextBox x:Name="FMax"/></StackPanel>
            <StackPanel Style="{StaticResource Cell}"><TextBlock Text="Change every (s)" Style="{StaticResource Lbl}"/><TextBox x:Name="FInt"/></StackPanel>
          </WrapPanel>
          <WrapPanel>
            <StackPanel Style="{StaticResource Cell}"><TextBlock Text="Latency ms" Style="{StaticResource Lbl}"/><TextBox x:Name="FLatMin"/><TextBlock Text="to" Style="{StaticResource Lbl}" Margin="4,0,0,0"/><TextBox x:Name="FLatMax"/></StackPanel>
            <StackPanel Style="{StaticResource Cell}"><TextBlock Text="Jitter ms" Style="{StaticResource Lbl}"/><TextBox x:Name="FJitMin"/><TextBlock Text="to" Style="{StaticResource Lbl}" Margin="4,0,0,0"/><TextBox x:Name="FJitMax"/></StackPanel>
            <StackPanel Style="{StaticResource Cell}"><TextBlock Text="Loss %" Style="{StaticResource Lbl}"/><TextBox x:Name="FLossMin"/><TextBlock Text="to" Style="{StaticResource Lbl}" Margin="4,0,0,0"/><TextBox x:Name="FLossMax"/></StackPanel>
          </WrapPanel>
          <Button x:Name="FluctBtn" Content="Fluctuate: OFF" Click="Fluct_Click" HorizontalAlignment="Left" Margin="0,6,0,0" MinWidth="170"/>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Spikes (apply instantly, then return to GOOD or FLUCTUATING)">
        <StackPanel>
          <WrapPanel>
            <StackPanel Style="{StaticResource Cell}"><TextBlock Text="Duration (s)" Style="{StaticResource Lbl}"/><TextBox x:Name="DurBox" Text="5"/><ComboBox x:Name="DurPreset" MinWidth="60"/></StackPanel>
          </WrapPanel>
          <WrapPanel>
            <StackPanel Style="{StaticResource Cell}"><TextBlock Text="Down strength" Style="{StaticResource Lbl}"/><ComboBox x:Name="DownStrength"/></StackPanel>
            <StackPanel Style="{StaticResource Cell}"><TextBlock Text="Target Kbps" Style="{StaticResource Lbl}"/><TextBox x:Name="DownKbps"/></StackPanel>
            <StackPanel Style="{StaticResource Cell}"><TextBlock Text="Loss %" Style="{StaticResource Lbl}"/><TextBox x:Name="DownLoss"/></StackPanel>
          </WrapPanel>
          <WrapPanel>
            <StackPanel Style="{StaticResource Cell}"><TextBlock Text="Up strength" Style="{StaticResource Lbl}"/><ComboBox x:Name="UpStrength"/></StackPanel>
            <StackPanel Style="{StaticResource Cell}"><TextBlock Text="Target Kbps" Style="{StaticResource Lbl}"/><TextBox x:Name="UpKbps"/></StackPanel>
            <TextBlock Text="(0 = unlimited)" Foreground="Gray" Style="{StaticResource Lbl}"/>
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="SpikeDownBtn" Content="Spike DOWN now" Click="SpikeDown_Click" Background="#FFFCA5A5" FontWeight="Bold" MinWidth="170"/>
            <Button x:Name="SpikeUpBtn" Content="Spike UP now" Click="SpikeUp_Click" Background="#FF93C5FD" FontWeight="Bold" MinWidth="170"/>
          </StackPanel>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Scripted sequence (edit config.json to add or change)">
        <WrapPanel>
          <ComboBox x:Name="SeqBox" MinWidth="200" Margin="0,0,12,0"/>
          <Button x:Name="SeqStartBtn" Content="Start sequence" Click="SeqStart_Click"/>
          <Button x:Name="SeqStopBtn" Content="Stop sequence" Click="SeqStop_Click"/>
        </WrapPanel>
      </GroupBox>

      <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#FF374151"
                 Text="For mobile: turn on Windows Mobile hotspot, connect the phone to the PC hotspot (not office Wi-Fi), keep Target = All traffic, then open the UAT meeting in Chrome on the phone. Fluctuate / Spike buttons here affect both the PC and the phone. Stop (or closing the app) returns the network to normal."/>
    </StackPanel>
  </ScrollViewer>
</Window>
